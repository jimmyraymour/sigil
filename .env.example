# ---------------------------------------------------------------
# Sigil — environment configuration
# Copy to .env and fill in your values:  cp .env.example .env
# ---------------------------------------------------------------

# ---- App ----
APP_ENV=development
APP_DEBUG=true
APP_BASE_URL=http://127.0.0.1:8001
APP_TIMEZONE=America/Santo_Domingo

# Secret used to sign asset URLs (generate one):
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# API key the web UI uses to call the API. Create one with:
#   php bin/sigil key:create web
# then paste the returned key here.
WEB_API_KEY=

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sigil
DB_USER=sigil
DB_PASS=changeme

# ---- LLM (brief refinement + iteration) — local Ollama first, OpenRouter fallback ----
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT=120
# Pass the previous PNG render to the LLM during iteration (vision).
# Can be slow on CPU-only boxes — set to false to iterate text-only.
OLLAMA_VISION=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
LLM_TEMPERATURE=0.7

# ---- Image providers ----
# Recraft (SVG logos) — https://www.recraft.ai
# --- Free model (default). No key, no account, no cost. ---
POLLINATIONS_MODEL=flux
POLLINATIONS_SIZE=1024
POLLINATIONS_TIMEOUT=120
POLLINATIONS_BATCH_DELAY=3

# --- Premium models. Each stays hidden in the UI until its key is set. ---
# Nano Banana. Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image
GEMINI_COST_ESTIMATE=0.04

RECRAFT_API_KEY=
RECRAFT_API_URL=https://external.api.recraft.ai/v1
RECRAFT_MODEL_SVG=recraftv4_1_vector
RECRAFT_MODEL_PNG=recraftv4_1
RECRAFT_STYLE=
RECRAFT_SIZE=
RECRAFT_COST_ESTIMATE=0.04

# Ideogram (wordmarks / PNG) — https://developer.ideogram.ai
IDEOGRAM_API_KEY=
IDEOGRAM_API_URL=https://api.ideogram.ai
IDEOGRAM_ASPECT_RATIO=1x1
IDEOGRAM_RENDERING_SPEED=TURBO
IDEOGRAM_STYLE_TYPE=AUTO
IDEOGRAM_COST_ESTIMATE=0.10

# ---- Defaults ----
# Empty = cheapest model that is actually usable right now (pollinations).
DEFAULT_PROVIDER=
DEFAULT_STYLE=auto
DEFAULT_ENTITY_TYPE=company
DEFAULT_VARIANTS=4
MAX_VARIANTS=8

# Stub provider lets you test the full pipeline with NO API keys by
# requesting provider=stub (generates a placeholder SVG/PNG locally).

# ---- HTTP ----
HTTP_TIMEOUT_SECONDS=60
HTTP_USER_AGENT=Sigil/1.0

# ---- Rate limiting / cost guardrails ----
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_RENDERS_PER_HOUR=30
COST_LIMIT_USD_PER_DAY=5.00
ASSET_URL_TTL_SECONDS=3600

# Meridian tracker. Key comes from the project's Meridian guide — never commit it.
MERIDIAN_API_KEY=
MERIDIAN_API_URL=http://localhost/meridian/api
MERIDIAN_PROJECT_ID=sigil

# Post-processing: image models often ignore "white background".
# TRANSPARENT=true yields a transparent PNG instead of white.
POSTPROCESS_ENABLED=true
POSTPROCESS_TRIM=true
POSTPROCESS_TRANSPARENT=false
