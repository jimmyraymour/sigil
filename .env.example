# ---------------------------------------------------------------
# Sigil — environment configuration
# Copy to .env and fill in your values:  cp .env.example .env
# ---------------------------------------------------------------

# ---- App ----
APP_ENV=development
APP_DEBUG=true
APP_BASE_URL=http://127.0.0.1:8001
APP_TIMEZONE=America/Santo_Domingo

# Secret used to sign asset URLs (generate one):
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# API key the web UI uses to call the API. Create one with:
#   php bin/sigil key:create web
# then paste the returned key here.
WEB_API_KEY=

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sigil
DB_USER=sigil
DB_PASS=changeme

# ---- LLM (brief refinement + iteration) + image providers ----
# AI routes cutover (2026-09-11): Bifrost is the only thing that talks to AI providers
# (root CLAUDE.md). Ollama, OpenRouter, Pollinations, Gemini/Nano Banana, Recraft and
# Ideogram are all routes managed in Bifrost -> AI & Keys now, not variables here — add or
# rotate a key there. See docs/superpowers/specs/2026-09-10-bifrost-ai-routes-design.md.
LLM_TEMPERATURE=0.7
# Iteration can pass the previous render to the vision job; can be slow on CPU-only boxes.
VISION_ITERATION_ENABLED=true

# ---- Bifrost (SSO + AI) — see bifrost/shared/php/BifrostClient.php docblock ----
BIFROST_BASE_URL=https://bifrost.raymour.local
BIFROST_CA_BUNDLE=C:/xampp/htdocs/raymour/bifrost/shared/ca/causeway-local-ca.crt
# Authenticates this project to Bifrost (X-Bifrost-Key). Mint with:
#   php bifrost/scripts/make_service_key.php mint --project=sigil --label="..." --scopes=ai,secrets.read
BIFROST_SERVICE_KEY=

# ---- Defaults ----
# Empty = cheapest available Bifrost route right now (pollinations); otherwise a route
# slug from Bifrost::aiRoutes('image') — see AI & Keys -> Routes for the current list.
DEFAULT_PROVIDER=
DEFAULT_STYLE=auto
DEFAULT_ENTITY_TYPE=company
DEFAULT_VARIANTS=4
MAX_VARIANTS=8

# ---- HTTP ----
HTTP_TIMEOUT_SECONDS=60
HTTP_USER_AGENT=Sigil/1.0

# ---- Rate limiting / cost guardrails ----
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_RENDERS_PER_HOUR=30
COST_LIMIT_USD_PER_DAY=5.00
ASSET_URL_TTL_SECONDS=3600

# Meridian tracker. Key comes from the project's Meridian guide — never commit it.
MERIDIAN_API_KEY=
MERIDIAN_API_URL=http://localhost/meridian/api
MERIDIAN_PROJECT_ID=sigil

# Post-processing: image models often ignore "white background".
# TRANSPARENT=true yields a transparent PNG instead of white.
POSTPROCESS_ENABLED=true
POSTPROCESS_TRIM=true
POSTPROCESS_TRANSPARENT=false
